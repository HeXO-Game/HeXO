{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "composite": true,
        "outDir": "./dist",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "exclude": [
        "node_modules",
        "dist",
        "playwright.config.ts",
        "vite.config.ts"
    ],
    "include": ["src", "src/**/*.json"],
    "references": [
        { "path": "../board-renderer" },
        { "path": "../shared" }
    ]
}
