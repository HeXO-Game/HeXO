{
    "name": "@ih3t/frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "pnpm run build:client && pnpm run build:server",
        "build:client": "vite build --outDir dist/client",
        "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/ssr",
        "build-dev": "pnpm run build-dev:client && pnpm run build-dev:server",
        "build-dev:client": "vite build -m development --outDir dist/client",
        "build-dev:server": "vite build -m development --ssr src/entry-server.tsx --outDir dist/ssr",
        "type-check": "tsc --noEmit",
        "preview": "vite preview",
        "clean": "rm -rf dist",
        "test-ct": "playwright test"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@ih3t/board-renderer": "workspace:*",
        "@ih3t/bot-worker": "workspace:*",
        "@ih3t/shared": "workspace:*",
        "@openreplay/tracker": "^18.1.5",
        "@openreplay/tracker-assist": "^11.0.21",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-query-devtools": "^5.102.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.2.6",
        "i18next": "^26.4.2",
        "immer": "^10.2.0",
        "lucide-react": "^1.42.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.13",
        "react-router": "^7.18.3",
        "react-toastify": "^11.1.0",
        "recharts": "^3.10.1",
        "shadcn": "^4.21.0",
        "socket.io-client": "^4.8.3",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@ih3t/build-utils": "workspace:*",
        "@playwright/experimental-ct-react": "^1.62.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^25.9.5",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "autoprefixer": "^10.5.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "postcss": "^8.5.28",
        "scheduler": "^0.27.0",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2",
        "vite": "^8.2.2"
    }
}
